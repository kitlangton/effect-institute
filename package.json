{
  "name": "effect-institute",
  "private": true,
  "license": "MIT",
  "homepage": "https://www.effect.institute",
  "repository": "https://github.com/kitlangton/effect-institute",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3210",
    "build": "bun narrate build --published && vite build",
    "serve": "vite preview",
    "cf:dev": "wrangler dev --port 8788",
    "cf:deploy": "bun scripts/deploy/cf-deploy.ts production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "prepush": "bun run fix && bun run typecheck && bun run test && bun run build && bun run og",
    "narrate": "bun src/lib/tooling/cli.ts",
    "og": "bun scripts/generate-og/main.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@floating-ui/react": "0.27.19",
    "@number-flow/react": "0.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "2.3.2",
    "@radix-ui/react-dropdown-menu": "2.1.19",
    "@radix-ui/react-slider": "1.4.2",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "effect": "4.0.0",
    "motion": "12.42.2",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "4.0.2",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@cloudflare/vite-plugin": "1.43.0",
    "@effect/language-service": "0.87.3",
    "@effect/vitest": "4.0.0",
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "wrangler": "4.107.0"
  }
}
