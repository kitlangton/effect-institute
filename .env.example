# Copy to .env and fill in what you need. Nothing here is required to run, test or build the site:
# bun install, bun dev, bun run test and bun run build all work with no .env at all.

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys).
# Used for word-level alignment (bun narrate align, and automatically after recording)
# and for generating narration (bun narrate generate). Without it, recordings get estimated timings.
ELEVENLABS_API_KEY=

# Voice used by bun narrate generate (or pass --voice). Find voice IDs at https://elevenlabs.io/app/voice-library
# or with GET https://api.elevenlabs.io/v1/voices.
ELEVENLABS_VOICE_ID=

# Optional text-to-speech model. Defaults to eleven_v4 (https://elevenlabs.io/docs/overview/models).
ELEVENLABS_MODEL_ID=

# Optional: a shell command run on every recorded take before loudness normalization, for your own
# clean-up chain (noise reduction, a plugin host, sox). It reads $AUTHORING_AUDIO_IN (WAV, mono 48 kHz)
# and must write $AUTHORING_AUDIO_OUT (WAV). Example:
# AUTHORING_AUDIO_CHAIN_CMD=sox "$AUTHORING_AUDIO_IN" "$AUTHORING_AUDIO_OUT" noisered noise.prof 0.2
AUTHORING_AUDIO_CHAIN_CMD=
